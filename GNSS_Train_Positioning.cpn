  <cpnet>
    <globbox>
      <block id="ID1">
        <id>Global Declarations</id>
        <ml id="ID2"><![CDATA[
(* ========================================== *)
(* GNSS Train Positioning CPN Model          *)
(* Based on Petrii.PDF paper specifications  *)
(* ========================================== *)

(* ========================================== *)
(* COLOR SET DEFINITIONS                     *)
(* ========================================== *)

(* Basic color sets *)
colset INT = int;
colset REAL = real;
colset BOOL = bool;
colset STRING = string;
colset TIME = int;

(* GNSS Signal representation *)
colset SIGNAL = record 
  id: INT *
  frequency: REAL *
  amplitude: REAL *
  phase: REAL *
  snr: REAL;

colset SIGNALLIST = list SIGNAL;

(* Coordinate system *)
colset COORDINATE = record
  x: REAL *
  y: REAL *
  z: REAL *
  timestamp: TIME;

colset COORDINATELIST = list COORDINATE;

(* State information for EKF *)
colset STATEINFE = record
  position: COORDINATE *
  velocity: REAL *
  acceleration: REAL *
  covariance: REAL;

(* Scenario definition *)
colset SCENARIO = record
  scenarioId: INT *
  scenarioType: STRING *
  interferenceLevel: REAL *
  tunnelLength: REAL *
  mountainHeight: REAL;

(* Measurement data *)
colset MEASUREMENT = record
  signalData: SIGNALLIST *
  timestamp: TIME *
  satelliteId: INT;

colset MEASUREMENTLIST = list MEASUREMENT;

(* Error model *)
colset ERROR = record
  errorType: STRING *
  magnitude: REAL *
  timestamp: TIME;

colset ERRORLIST = list ERROR;

(* Position solution *)
colset POSITION = record
  estimated: COORDINATE *
  actual: COORDINATE *
  error: REAL *
  timestamp: TIME;

colset POSITIONLIST = list POSITION;

(* Evaluation results *)
colset EVALUATION = record
  scenario: STRING *
  meanError: REAL *
  maxError: REAL *
  rmsError: REAL *
  successRate: REAL;

colset EVALUATIONLIST = list EVALUATION;

(* Filter state *)
colset FILTERSTATE = record
  state: STATEINFE *
  kalmanGain: REAL *
  innovation: REAL;

(* Control signals *)
colset CONTROL = with Start | Stop | Reset | Process;

(* Status *)
colset STATUS = with Ready | Processing | Complete | Error;

(* ========================================== *)
(* VARIABLE DECLARATIONS                     *)
(* ========================================== *)

var sig: SIGNAL;
var sigList: SIGNALLIST;
var coord: COORDINATE;
var coordList: COORDINATELIST;
var state: STATEINFE;
var scenario: SCENARIO;
var measurement: MEASUREMENT;
var measList: MEASUREMENTLIST;
var err: ERROR;
var errList: ERRORLIST;
var pos: POSITION;
var posList: POSITIONLIST;
var eval: EVALUATION;
var evalList: EVALUATIONLIST;
var filterState: FILTERSTATE;
var ctrl: CONTROL;
var status: STATUS;

var x, y, z: REAL;
var v, a: REAL;
var t, dt: TIME;
var snr, freq, amp, phase: REAL;
var id, satId: INT;
var scenType: STRING;
var intLevel, tunnelLen, mountHeight: REAL;

(* ========================================== *)
(* HELPER FUNCTIONS                          *)
(* ========================================== *)

(* Create initial coordinate *)
fun makeCoord(x_val: real, y_val: real, z_val: real, t_val: int) : COORDINATE =
  {x=x_val, y=y_val, z=z_val, timestamp=t_val};

(* Create initial signal *)
fun makeSignal(id_val: int, freq_val: real, amp_val: real, phase_val: real, snr_val: real) : SIGNAL =
  {id=id_val, frequency=freq_val, amplitude=amp_val, phase=phase_val, snr=snr_val};

(* Create initial state *)
fun makeState(pos: COORDINATE, vel: real, acc: real, cov: real) : STATEINFE =
  {position=pos, velocity=vel, acceleration=acc, covariance=cov};

(* ========================================== *)
(* INTERFERENCE FUNCTIONS                    *)
(* ========================================== *)

(* AM Interference *)
fun applyAMInterference(sig: SIGNAL, level: real) : SIGNAL =
  let
    val newAmp = #amplitude sig * (1.0 + level * Math.sin(2.0 * Math.pi * 0.1))
    val newSNR = #snr sig - level * 3.0
  in
    {id = #id sig, frequency = #frequency sig, amplitude = newAmp, 
     phase = #phase sig, snr = newSNR}
  end;

(* FM Interference *)
fun applyFMInterference(sig: SIGNAL, level: real) : SIGNAL =
  let
    val newPhase = #phase sig + level * Math.sin(2.0 * Math.pi * 0.2)
    val newSNR = #snr sig - level * 2.5
  in
    {id = #id sig, frequency = #frequency sig, amplitude = #amplitude sig,
     phase = newPhase, snr = newSNR}
  end;

(* Pulse Interference *)
fun applyPulseInterference(sig: SIGNAL, level: real) : SIGNAL =
  let
    val newAmp = if level > 0.5 then 0.1 * #amplitude sig else #amplitude sig
    val newSNR = if level > 0.5 then #snr sig - 10.0 else #snr sig
  in
    {id = #id sig, frequency = #frequency sig, amplitude = newAmp,
     phase = #phase sig, snr = newSNR}
  end;

(* Apply all interferences *)
fun applyInterference(sig: SIGNAL, scenario: SCENARIO) : SIGNAL =
  let
    val level = #interferenceLevel scenario
    val sig1 = applyAMInterference(sig, level * 0.3)
    val sig2 = applyFMInterference(sig1, level * 0.3)
    val sig3 = applyPulseInterference(sig2, level * 0.4)
  in
    sig3
  end;

(* ========================================== *)
(* MOUNTAIN FILTERING                        *)
(* ========================================== *)

fun mountainFiltering(coord: COORDINATE, mountHeight: real) : COORDINATE =
  let
    val shadowing = if mountHeight > 1000.0 then 0.7 else 0.9
    val errorX = #x coord * (1.0 - shadowing) * 0.1
    val errorY = #y coord * (1.0 - shadowing) * 0.1
    val errorZ = #z coord + mountHeight * 0.05
  in
    {x = #x coord + errorX, y = #y coord + errorY, 
     z = errorZ, timestamp = #timestamp coord}
  end;

(* ========================================== *)
(* TUNNEL ERROR MODELING                     *)
(* ========================================== *)

fun tunnelError(coord: COORDINATE, tunnelLen: real) : COORDINATE =
  let
    val signalLoss = if tunnelLen > 100.0 then 0.8 else 0.5
    val errorX = #x coord * signalLoss * 0.2
    val errorY = #y coord * signalLoss * 0.2
    val errorZ = #z coord * signalLoss * 0.15
  in
    {x = #x coord + errorX, y = #y coord + errorY,
     z = #z coord + errorZ, timestamp = #timestamp coord}
  end;

(* ========================================== *)
(* EXTENDED KALMAN FILTER (EKF)             *)
(* ========================================== *)

(* EKF Prediction step *)
fun ekfPredict(state: STATEINFE, dt: real) : STATEINFE =
  let
    val oldPos = #position state
    val oldVel = #velocity state
    val oldAcc = #acceleration state
    
    (* Predict new position *)
    val newX = #x oldPos + oldVel * dt + 0.5 * oldAcc * dt * dt
    val newY = #y oldPos + oldVel * dt + 0.5 * oldAcc * dt * dt
    val newZ = #z oldPos
    val newPos = {x=newX, y=newY, z=newZ, timestamp=(#timestamp oldPos) + Real.floor(dt)}
    
    (* Predict new velocity *)
    val newVel = oldVel + oldAcc * dt
    
    (* Process noise covariance *)
    val newCov = #covariance state + 0.01
  in
    {position=newPos, velocity=newVel, acceleration=oldAcc, covariance=newCov}
  end;

(* EKF Update step *)
fun ekfUpdate(predictedState: STATEINFE, measurement: COORDINATE) : STATEINFE =
  let
    val predPos = #position predictedState
    val measNoise = 1.0
    
    (* Kalman gain *)
    val K = #covariance predictedState / (#covariance predictedState + measNoise)
    
    (* Innovation *)
    val innovX = #x measurement - #x predPos
    val innovY = #y measurement - #y predPos
    val innovZ = #z measurement - #z predPos
    
    (* Update position *)
    val newX = #x predPos + K * innovX
    val newY = #y predPos + K * innovY
    val newZ = #z predPos + K * innovZ
    val newPos = {x=newX, y=newY, z=newZ, timestamp=#timestamp measurement}
    
    (* Update covariance *)
    val newCov = (1.0 - K) * #covariance predictedState
  in
    {position=newPos, velocity=#velocity predictedState, 
     acceleration=#acceleration predictedState, covariance=newCov}
  end;

(* Complete EKF cycle *)
fun ekfCycle(state: STATEINFE, measurement: COORDINATE, dt: real) : STATEINFE =
  let
    val predicted = ekfPredict(state, dt)
    val updated = ekfUpdate(predicted, measurement)
  in
    updated
  end;

(* ========================================== *)
(* POSITION CALCULATION                      *)
(* ========================================== *)

fun calculatePosition(sigList: SIGNALLIST, scenario: SCENARIO) : COORDINATE =
  let
    (* Apply interferences *)
    val filteredSigs = map (fn sig => applyInterference(sig, scenario)) sigList
    
    (* Simple trilateration (simplified) *)
    val avgX = if List.length filteredSigs > 0 then
                 List.foldl (fn (s, acc) => acc + #amplitude s) 0.0 filteredSigs / 
                 real(List.length filteredSigs)
               else 0.0
    val avgY = avgX * 0.8
    val avgZ = 100.0
    
    val baseCoord = {x=avgX * 1000.0, y=avgY * 1000.0, z=avgZ, timestamp=0}
    
    (* Apply environmental effects *)
    val coord1 = mountainFiltering(baseCoord, #mountainHeight scenario)
    val coord2 = tunnelError(coord1, #tunnelLength scenario)
  in
    coord2
  end;

(* ========================================== *)
(* EVALUATION FUNCTIONS                      *)
(* ========================================== *)

fun calculateError(estimated: COORDINATE, actual: COORDINATE) : real =
  let
    val dx = #x estimated - #x actual
    val dy = #y estimated - #y actual
    val dz = #z estimated - #z actual
  in
    Math.sqrt(dx*dx + dy*dy + dz*dz)
  end;

fun evaluatePerformance(posList: POSITIONLIST) : EVALUATION =
  let
    val errors = map (fn p => #error p) posList
    val n = real(List.length errors)
    
    val meanErr = if n > 0.0 then (List.foldl op+ 0.0 errors) / n else 0.0
    val maxErr = if List.length errors > 0 then List.foldl Real.max 0.0 errors else 0.0
    val rmsErr = if n > 0.0 then 
                   Math.sqrt((List.foldl (fn (e, acc) => acc + e*e) 0.0 errors) / n)
                 else 0.0
    val successRate = if n > 0.0 then
                        real(List.length(List.filter (fn e => e < 10.0) errors)) / n
                      else 0.0
  in
    {scenario="General", meanError=meanErr, maxError=maxErr, 
     rmsError=rmsErr, successRate=successRate}
  end;

(* ========================================== *)
(* INITIAL DATA GENERATION                   *)
(* ========================================== *)

fun generateTestScenario(scenId: int) : SCENARIO =
  {scenarioId=scenId, scenarioType="Urban", interferenceLevel=0.3,
   tunnelLength=200.0, mountainHeight=500.0};

fun generateTestSignals() : SIGNALLIST =
  [makeSignal(1, 1575.42, 1.0, 0.0, 45.0),
   makeSignal(2, 1575.42, 0.9, 0.5, 43.0),
   makeSignal(3, 1575.42, 0.95, 1.0, 44.0),
   makeSignal(4, 1575.42, 0.85, 1.5, 42.0)];

fun generateInitialState() : STATEINFE =
  makeState(makeCoord(0.0, 0.0, 100.0, 0), 20.0, 0.5, 1.0);

]]></ml>
      </block>
