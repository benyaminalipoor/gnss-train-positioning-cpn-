    </page>
    
    <!-- Monitor for stopping simulation -->
    <monitor id="ID57">
      <timed val="true"/>
      <name>Simulation_Time_Monitor</name>
      <place idref="ID18"/>
      <predicate>
        (fn (t:TIME) =&gt; t &gt; 100)
      </predicate>
      <init>
        (fn () =&gt; ())
      </init>
      <stop>
        (fn () =&gt; print "Simulation completed after 100 time steps\n")
      </stop>
    </monitor>
    
    <options>
      <option name="realtimestamp" value="1000000000"/>
      <option name="fair_be" value="false"/>
      <option name="global_fairness" value="false"/>
      <option name="outputdirectory" value="output"/>
    </options>
  </cpnet>
</workspaceElements>
